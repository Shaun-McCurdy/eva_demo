# ---------------------------------------------------------------------------
# Copy to .env for local development. On Cloud Run set these with
# `gcloud run deploy --set-env-vars` / `--set-secrets` instead of shipping a file.
# ---------------------------------------------------------------------------

# --- Google Cloud / Vertex AI (required) -----------------------------------
# There is no Gemini API key here. Auth is Vertex AI via Application Default
# Credentials: `gcloud auth application-default login` locally, and the
# attached service account on Cloud Run.
GOOGLE_CLOUD_PROJECT=virtual-agent-demos
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-live-2.5-flash-native-audio
# Service account key for local dev (websitedemo@virtual-agent-demos.iam.gserviceaccount.com).
# Not needed on Cloud Run -- the attached service account is used there instead.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Shaun.McCurdy\PycharmProjects\eva-demo\virtual-agent-demos-eabc607dfdd2.json

# --- Sales-engineer studio (required) --------------------------------------
# Generate the hash with:  python server/security.py hash 'your-password'
# STUDIO_PASSWORD (plaintext) also works but is for local runs only.
STUDIO_PASSWORD_HASH=
STUDIO_PASSWORD=enghouseSE

# Signs the studio session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without it, logins break on every restart and across Cloud Run instances.
SESSION_SECRET=944f29ecda823a6d746f70c84a0aa76db685cd2dc2455a61e82faec6a3890de0
SESSION_TTL_SECONDS=43200
# Set false only when running over plain http on localhost.
COOKIE_SECURE=true

# --- Agent storage ----------------------------------------------------------
# file      = JSON on disk. Dev only: on Cloud Run it is per-instance and
#             disappears when the instance does.
# firestore = shared across instances and restarts. Use this in production.
STORE_BACKEND=file
STORE_FILE=./data/agents.json
FIRESTORE_COLLECTION=eva_demo_agents
FIRESTORE_DATABASE=(default)

# --- Abuse limits for a public demo URL ------------------------------------
MAX_SESSION_SECONDS=600
MAX_CONCURRENT_SESSIONS=12
MAX_SESSIONS_PER_IP=3
MAX_SESSIONS_PER_IP_HOUR=20
# Comma-separated. Empty allows any origin, which is fine locally but should be
# set to your real domain once you have one.
ALLOWED_ORIGINS=

# --- Serving ----------------------------------------------------------------
PORT=8080
STATIC_DIR=./web/dist
DEBUG=false
